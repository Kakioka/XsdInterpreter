<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema id="SchAMD" xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
  <xsd:annotation>
    <xsd:documentation>
      <Description>Hawaii Schedule Amended</Description>
    </xsd:documentation>
  </xsd:annotation>
  <xsd:include schemaLocation="../Common/efileTypes.xsd"/>
  <xsd:include schemaLocation="HIeFileTypes.xsd"/>
  <xsd:element name="SchAMD">
    <xsd:annotation>
      <xsd:documentation>
        <Description>SCHEDULE OF Amended Return</Description>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:complexContent>
        <xsd:extension base="SchAMDType">
          <xsd:attributeGroup ref="StateDocumentAttributes">
            <xsd:annotation>
              <xsd:documentation>Common return document attributes</xsd:documentation>
            </xsd:annotation>
          </xsd:attributeGroup>
        </xsd:extension>
      </xsd:complexContent>
    </xsd:complexType>
	</xsd:element>
  <xsd:complexType name="SchAMDType">
    <xsd:sequence>
      <xsd:element name="IRSCorrectedReturnInd" type ="BooleanType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            <Description>Has your original Federal Return been changed or corrected by the IRS</Description>
            <LineNumber>1</LineNumber>
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="NOLCarrybackInd" type ="BooleanType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            <Description>Does the change pertain to a net operating loss carryback</Description>
            <LineNumber>2</LineNumber>
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="ExplanationOfChange" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:annotation>
            <xsd:documentation>
              <LineNumber>3</LineNumber>
            </xsd:documentation>
          </xsd:annotation>
          <xsd:sequence>
            <xsd:element name ="FormOrSchedule" type ="StringType">
              <xsd:annotation>
                <xsd:documentation>
                  <description>Form or Schedule</description>
                </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name ="LineNumber" type ="StringType">
              <xsd:annotation>
                <xsd:documentation>
                  <description>Line Number</description>
                </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name ="Amount" type ="USAmountType">
              <xsd:annotation>
                <xsd:documentation>
                  <description>Amount of Change</description>
                </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name ="Explanation" type ="ShortExplanationType">
              <xsd:annotation>
                <xsd:documentation>
                  <description>Explanation</description>
                </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>
