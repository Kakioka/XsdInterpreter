<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2006 sp2 U (http://www.altova.com) by Robin Barnett-Wake (Comptroller of Maryland Information Technology Division) -->
<xsd:schema xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xsd:annotation>
		<xsd:documentation>
			<Description>Estandards version of IRS Form 1099-Int</Description>
			<TaxYear>2022</TaxYear>
			<ReleaseDate>July 12, 2022</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>
	<xsd:include schemaLocation="../../Common/efileTypes.xsd"/>
	<xsd:include schemaLocation="../../Common/StateeFileTypes.xsd"/>
	<xsd:element name="State1099Int">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="State1099IntType">
					<xsd:attributeGroup ref="DocumentAttributes">
						<xsd:annotation>
							<xsd:documentation>Common return document attributes</xsd:documentation>
						</xsd:annotation>
					</xsd:attributeGroup>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="State1099IntType">
		<xsd:sequence>
			<!-- Corrected Indicator -->
			<xsd:element name="CorrectedInd" type="CheckboxType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Corrected Indicator</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Void Indicator -->
			<xsd:element name="VoidInd" type="CheckboxType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Void Indicator</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Payer Name -->
			<xsd:element name="PayerName">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Payer name</Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="BusinessNameType">
							<xsd:attribute name="payerNameControl" type="BusinessNameControlType" use="required"/>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
			<!-- Payer Address -->
			<xsd:choice minOccurs="0">
				<!-- Payer US Address -->
				<xsd:element name="PayerUSAddress" type="USAddressType">
					<xsd:annotation>
						<xsd:documentation>
							<Description>Payer US address</Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<!-- Employer Foreign Address -->
				<xsd:element name="PayerForeignAddress" type="ForeignAddressType">
					<xsd:annotation>
						<xsd:documentation>
							<Description>Payer foreign address</Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<!-- Payer Phone Number -->
			<xsd:choice minOccurs="0">
				<xsd:element name="PayerPhone" type="PhoneNumberType"/>
				<xsd:element name="PayerForeignPhone" type="ForeignPhoneNumberType"/>
			</xsd:choice>
			<!-- Payer EIN -->
			<xsd:element name="PayerEIN" type="EINType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Payer Identification Number</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Recipient Identification Number -->
			<xsd:element name="RecipientSSN" type="SSNType">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Recipient SSN</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Recipient Name -->
			<xsd:element name="RecipientName" type="PersonNameType">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Recipient name</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Recipient Address -->
			<xsd:choice minOccurs="0">
				<!-- Recipient US Address -->
				<xsd:element name="RecipientUSAddress" type="USAddressType">
					<xsd:annotation>
						<xsd:documentation>
							<Description>Recipient US address</Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<!-- Recipient Foreign Address -->
				<xsd:element name="RecipientForeignAddress" type="ForeignAddressType">
					<xsd:annotation>
						<xsd:documentation>
							<Description>Recipient foreign address</Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<!-- Account Number -->
			<xsd:element name="AccountNumber" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Account Number</Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="StringType">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="FATCAFilingReqInd" type="CheckboxType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>FATCA Filing Requirement</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="TINNot" type="CheckboxType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>2nd TIN not.</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Payer's RTN -->
			<xsd:element name="PayerRoutingTransitNumber" type="RoutingTransitNumberType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Payer's RTN</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Interest Income -->
			<xsd:element name="InterestIncome" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Interest Income</Description>
						<LineNumber>1</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Early withdrawal penalty -->
			<xsd:element name="EarlyWithdrawalPenalty" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Early withdrawal penalty</Description>
						<LineNumber>2</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Interest on U.S. Savings Bonds and Treas. obligations -->
			<xsd:element name="InterestOnBondsAndTreasury" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Interest on U.S. Savings Bonds and Treas. obligations</Description>
						<LineNumber>3</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Federal income tax withheld -->
			<xsd:element name="FederalTaxWithheld" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Federal income tax withheld</Description>
						<LineNumber>4</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Investment expenses -->
			<xsd:element name="InvestmentExpenses" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Investment expenses</Description>
						<LineNumber>5</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Foreign tax paid -->
			<xsd:element name="ForeignTaxPaid" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Foreign tax paid</Description>
						<LineNumber>6</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Foreign country or U.S. possession -->
			<xsd:element name="Country" type="CountryType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Foreign country or U.S. possession</Description>
						<LineNumber>7</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Tax-exempt interest -->
			<xsd:element name="TaxExemptInterest" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Tax exempt interest</Description>
						<LineNumber>8</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<!-- Specified private activity bond interest -->
			<xsd:element name="ActivityBondInterest" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Specified private activity bond interest</Description>
						<LineNumber>9</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MarketDiscount" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Market Discount</Description>
						<LineNumber>10</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BondPremium" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Bond Premium</Description>
						<LineNumber>11</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BondPremiumTreasury" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Bond Premium on Treasury obligations</Description>
						<LineNumber>12</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BondPremiumTaxExempt" type="AmountType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Bond Premium on tax-exempt bond</Description>
						<LineNumber>13</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="TaxExemptCUSIP" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Tax exempt bond CUSIP no</Description>
						<LineNumber>14</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="AlphaNumericType">
						<xsd:length value="9"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="State1099IntStateLocalTaxGrp" type="StateLocalTaxGrpType" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<Description>State1099Int State Local Tax Group</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
